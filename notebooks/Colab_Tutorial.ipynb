    "axes[0].set_xlabel('RMSE (nhỏ hơn = tốt hơn)')\n",
    "axes[0].set_title('So sánh RMSE')\n",
    "axes[0].invert_yaxis()\n",
    "\n",
    "# MAE\n",
    "results_sorted = results.sort_values('MAE')\n",
    "axes[1].barh(results_sorted['Model'], results_sorted['MAE'], color='lightcoral')\n",
    "axes[1].set_xlabel('MAE (nhỏ hơn = tốt hơn)')\n",
    "axes[1].set_title('So sánh MAE')\n",
    "axes[1].invert_yaxis()\n",
    "\n",
    "# R² Score\n",
    "results_sorted = results.sort_values('R2_Score', ascending=False)\n",
    "axes[2].barh(results_sorted['Model'], results_sorted['R2_Score'], color='lightgreen')\n",
    "axes[2].set_xlabel('R² Score (lớn hơn = tốt hơn)')\n",
    "axes[2].set_title('So sánh R² Score')\n",
    "axes[2].invert_yaxis()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"

   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Bước 7: Demo Dự Báo Giá (Web Interface với Gradio)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import os\n",
    "import pickle\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import gradio as gr\n",
    "\n",
    "# Kiểm tra file cần thiết\n",
    "model_path = 'results/models/xgboost.pkl'\n",
    "data_path = 'data/processed/engineered_housing_data.csv'\n",
    "\n",
    "if not os.path.exists(model_path):\n",
    "    raise FileNotFoundError(f'Không tìm thấy: {model_path}')\n",
    "\n",
    "if not os.path.exists(data_path):\n",
    "    raise FileNotFoundError(f'Không tìm thấy: {data_path}')\n",
    "\n",
    "# Tải mô hình\n",
    "with open(model_path, 'rb') as f:\n",
    "    model = pickle.load(f)\n",
    "\n",
    "# Tải dữ liệu\n",
    "df = pd.read_csv(data_path)\n",
    "\n",
    "# Xác định các cột đặc trưng\n",
    "numeric_columns = df.select_dtypes(include=[np.number]).columns.tolist()\n",
    "feature_columns = [col for col in numeric_columns if col != 'price']\n",
    "\n",
    "X = df[feature_columns].copy()\n",
    "default_values = X.median().fillna(0)\n",
    "\n",
    "price_mean = df['price'].mean()\n",
    "price_std = df['price'].std()\n",
    "\n",
    "def predict_price(area, bedrooms, bathrooms, floor, frontage, year_built):\n",
    "    \"\"\"Dự báo giá dựa trên thông tin nhập từ người dùng.\"\"\"\n",
    "    \n",
    "    # Khởi tạo mẫu với giá trị trung vị\n",
    "    sample = default_values.copy()\n",
    "    \n",
    "    # Gán các giá trị cơ bản\n",
    "    if 'area' in sample.index:\n",
    "        sample['area'] = area\n",
    "    if 'bedrooms' in sample.index:\n",
    "        sample['bedrooms'] = bedrooms\n",
    "    if 'bathrooms' in sample.index:\n",
    "        sample['bathrooms'] = bathrooms\n",
    "    if 'floor' in sample.index:\n",
    "        sample['floor'] = floor\n",
    "    if 'street_frontage' in sample.index:\n",
    "        sample['street_frontage'] = frontage\n",
    "    if 'year_built' in sample.index:\n",
    "        sample['year_built'] = year_built\n",
    "    \n",
    "    # Các đặc trưng phát sinh\n",
    "    if 'bedrooms_per_100sqm' in sample.index:\n",
    "        sample['bedrooms_per_100sqm'] = bedrooms / max(area, 1) * 100\n",
    "    if 'bathrooms_per_bedroom' in sample.index:\n",
    "        sample['bathrooms_per_bedroom'] = bathrooms / max(bedrooms, 1)\n",
    "    if 'building_age' in sample.index:\n",
    "        sample['building_age'] = max(2026 - year_built, 0)\n",
    "    if 'frontage_area_ratio' in sample.index:\n",
    "        sample['frontage_area_ratio'] = frontage / max(area, 1)\n",
    "    \n",
    "    # Bảo đảm đúng thứ tự cột\n",
    "    input_df = pd.DataFrame([sample], columns=feature_columns)\n",
    "    \n",
    "    # Dự đoán\n",
    "    prediction_scaled = float(model.predict(input_df)[0])\n",
    "    prediction = prediction_scaled * price_std + price_mean\n",
    "    \n",
    "    return (\n",
    "        f\"📊 KẾT QUẢ DỰ BÁOGIÁ NHÀ\\n\\n\"\n",
    "        f\"💰 Giá dự đoán: {prediction:,.2f}\\n\\n\"\n",
    "        f\"📋 Chi tiết căn nhà:\\n\"\n",
    "        f\"   • Diện tích: {area} m²\\n\"\n",
    "        f\"   • Phòng ngủ: {bedrooms}\\n\"\n",
    "        f\"   • Phòng tắm: {bathrooms}\\n\"\n",
    "        f\"   • Số tầng: {floor}\\n\"\n",
    "        f\"   • Mặt tiền: {frontage}m\\n\"\n",
    "        f\"   • Năm xây dựng: {year_built}\"\n",
    "    )\n",
    "\n",
    "# Tạo giao diện Gradio\n",
    "demo = gr.Interface(\n",
    "    fn=predict_price,\n",
    "    inputs=[\n",
    "        gr.Number(value=100, label='📐 Diện tích (m²)'),\n",
    "        gr.Slider(1, 10, value=3, step=1, label='🛏️ Số phòng ngủ'),\n",
    "        gr.Slider(1, 6, value=2, step=1, label='🚿 Số phòng tắm'),\n",
    "        gr.Slider(1, 20, value=3, step=1, label='📈 Số tầng'),\n",
    "        gr.Number(value=5, label='📏 Chiều rộng mặt tiền (m)'),\n",
    "        gr.Slider(1950, 2026, value=2015, step=1, label='📅 Năm xây dựng'),\n",
    "    ],\n",
    "    outputs=gr.Textbox(label='💬 Kết quả dự báo', lines=10),\n",
    "    title='🏠 DEMO DỰ BÁOGIÁ NHÀ',\n",
    "    description='Nhập thông tin căn nhà để xem kết quả dự báo giá. Lưu ý: Đây là bản demo dùng dữ liệu mô phỏng.',\n",
    "    allow_flagging='never',\n",
    "    theme=gr.themes.Soft()\n",
    ")\n",
    "\n",
    "print('\\n' + '='*50)\n",
    "print('🌐 KHỞI ĐỘNG WEB DEMO')\n",
    "print('='*50)\n",
    "print('Chờ link xuất hiện...\\n')\n",
    "\n",
    "demo.launch(share=True, debug=False)"
   ]
  },
